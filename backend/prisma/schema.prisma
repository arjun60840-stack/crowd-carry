// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  firstName         String
  lastName          String
  phone             String?
  avatar            String?
  role              String    @default("USER") // USER, TRAVELER, ADMIN
  isVerified        Boolean   @default(false)
  isEmailVerified   Boolean   @default(false)
  isPhoneVerified   Boolean   @default(false)
  idDocumentUrl     String?
  bio               String?
  city              String?
  country           String?
  
  // KYC Level System
  kycStatus           String    @default("PENDING") // PENDING, APPROVED, REJECTED
  verificationLevel   Int       @default(0) // 0: email, 1: phone, 2: ID, 3: selfie, 4: trusted carrier
  aadhaarNumber       String?
  panNumber           String?
  selfieImage         String?
  verificationDate    DateTime?
  verifiedBadge       Boolean   @default(false)
  
  // Trust & Reputation
  trustScore        Float     @default(100)
  rating            Float     @default(0)
  totalRatings      Int       @default(0)
  completedDeliveries Int     @default(0)
  totalTrips        Int       @default(0)
  successRate       Float     @default(0)
  
  // Badges
  isTrustedTraveler Boolean   @default(false)
  isVerifiedBadge   Boolean   @default(false)
  isTopCarrier      Boolean   @default(false)
  
  // Risk
  riskScore         Float     @default(0)
  riskLevel         String    @default("LOW") // LOW, MEDIUM, HIGH
  
  // Reset Password
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  emailVerifyToken    String?
  emailVerifyExpiry   DateTime?
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?
  
  // Relations
  trips             Trip[]
  packages          Package[]
  matchesAsTraveler Match[]   @relation("TravelerMatches")
  matchesAsSender   Match[]   @relation("SenderMatches")
  reviewsGiven      Review[]  @relation("ReviewsGiven")
  reviewsReceived   Review[]  @relation("ReviewsReceived")
  notifications     Notification[]
  reportsFiledBy    Report[]  @relation("ReportsFiledBy")
  reportsAgainst    Report[]  @relation("ReportsAgainst")
  transactions      Transaction[]
  messagesSent      Message[] @relation("SentMessages")
  disputesFiled     Dispute[] @relation("DisputesFiled")
  disputesAgainst   Dispute[] @relation("DisputesAgainst")
  insuranceClaims   InsuranceClaim[] @relation("UserClaims")
  
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Trip {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  sourceCity        String
  sourceCountry     String?
  sourceLat         Float?
  sourceLng         Float?
  destinationCity   String
  destinationCountry String?
  destinationLat    Float?
  destinationLng    Float?
  
  travelDate        DateTime
  travelTime        String?
  vehicleType       String      @default("CAR")
  availableCapacity Float       // in liters or cubic cm
  availableWeight   Float       // in kg
  pricePerKg        Float?
  
  notes             String?
  isActive          Boolean     @default(true)
  isCompleted       Boolean     @default(false)
  
  // Route data
  routeDistance     Float?      // km
  estimatedDuration Int?        // minutes
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  // Relations
  matches           Match[]
  
  @@index([isActive, isCompleted, travelDate])
  @@index([sourceCity, destinationCity])
  @@map("trips")
}

model Package {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title             String
  description       String?
  
  pickupAddress     String
  pickupCity        String
  pickupCountry     String?
  pickupLat         Float?
  pickupLng         Float?
  
  destinationAddress  String
  destinationCity     String
  destinationCountry  String?
  destinationLat      Float?
  destinationLng      Float?
  
  weight            Float           // kg
  size              String          @default("MEDIUM")
  category          String          @default("OTHER")
  urgency           String          @default("STANDARD")
  
  rewardAmount      Float
  suggestedMin      Float?
  suggestedRecommended Float?
  suggestedPremium  Float?
  
  status            String          @default("PENDING")
  escrowStatus      String          @default("UNFUNDED")
  paymentStatus     String          @default("PENDING")
  imageUrls         String          @default("[]") // JSON stringified array
  
  // Package Verification & Safety
  packagePhoto      String?
  dimensions        String?         // e.g. "30x20x10 cm"
  qrCodeData        String?         // Unique QR code payload
  
  // Insurance
  estimatedValue    Float?
  isInsured         Boolean         @default(false)
  insurancePlan     String?         // BASIC, PREMIUM, ENTERPRISE
  
  // Delivery details
  deliveryPin       String?
  deliveredAt       DateTime?
  pickedUpAt        DateTime?
  
  // Risk
  riskScore         Float           @default(0)
  riskLevel         String          @default("LOW")
  
  // CO2 calculations
  co2Saved          Float?
  distanceSaved     Float?
  moneySaved        Float?
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  // Relations
  matches           Match[]
  reviews           Review[]
  transactions      Transaction[]
  packageHistories  PackageHistory[]
  disputes          Dispute[]
  insurancePolicy   InsurancePolicy?
  
  @@index([userId])
  @@index([status])
  @@index([pickupCity, destinationCity])
  @@map("packages")
}

model Match {
  id                String        @id @default(uuid())
  packageId         String
  package           Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  tripId            String
  trip              Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  travelerId        String
  traveler          User          @relation("TravelerMatches", fields: [travelerId], references: [id])
  senderId          String
  sender            User          @relation("SenderMatches", fields: [senderId], references: [id])
  
  // Match scores
  matchScore        Float         // 0-100
  routeScore        Float
  dateScore         Float
  weightScore       Float
  ratingScore       Float
  successRateScore  Float
  
  // Match quality label
  matchQuality      String        // "Excellent", "Good", "Average"
  explanation       String?
  
  isAccepted        Boolean       @default(false)
  isRejected        Boolean       @default(false)
  acceptedAt        DateTime?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  messages          Message[]
  
  @@index([packageId])
  @@index([tripId])
  @@index([travelerId])
  @@unique([packageId, tripId])
  @@map("matches")
}

model Review {
  id                String    @id @default(uuid())
  reviewerId        String
  reviewer          User      @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId        String
  reviewee          User      @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  packageId         String?
  package           Package?  @relation(fields: [packageId], references: [id])
  
  rating            Int       // 1-5
  comment           String?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@map("reviews")
}

model Notification {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type              String
  title             String
  message           String
  data              String?           // JSON stringified object
  isRead            Boolean           @default(false)
  
  createdAt         DateTime          @default(now())
  
  @@map("notifications")
}

model Report {
  id                String        @id @default(uuid())
  reporterId        String
  reporter          User          @relation("ReportsFiledBy", fields: [reporterId], references: [id])
  reportedUserId    String
  reportedUser      User          @relation("ReportsAgainst", fields: [reportedUserId], references: [id])
  
  reason            String
  description       String
  evidenceUrls      String        @default("[]") // JSON stringified array
  status            String        @default("PENDING")
  adminNotes        String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@map("reports")
}

model Transaction {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  packageId         String?
  package           Package?  @relation(fields: [packageId], references: [id])
  
  type              String    // "payment", "reward", "refund"
  amount            Float
  currency          String    @default("USD")
  status            String    @default("pending") // pending, completed, failed
  description       String?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@map("transactions")
}
model Message {
  id                String    @id @default(uuid())
  matchId           String
  match             Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId          String
  sender            User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  
  text              String
  isRead            Boolean   @default(false)
  
  createdAt         DateTime  @default(now())
  
  @@map("messages")
}

model PackageHistory {
  id           String   @id @default(uuid())
  packageId    String
  package      Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  status       String
  description  String
  latitude     Float?
  longitude    Float?
  scanType     String?  // PICKUP, TRANSIT, DELIVERY, VERIFICATION
  operatorId   String?
  createdAt    DateTime @default(now())

  @@map("package_histories")
}

model Dispute {
  id             String   @id @default(uuid())
  packageId      String
  package        Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  reporterId     String
  reporter       User     @relation("DisputesFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   User?    @relation("DisputesAgainst", fields: [reportedUserId], references: [id])
  type           String   // LOST_PACKAGE, DAMAGED_PACKAGE, WRONG_DELIVERY, PAYMENT_ISSUE, CARRIER_MISCONDUCT
  description    String
  evidenceUrls   String   @default("[]") // JSON array of urls
  status         String   @default("PENDING") // PENDING, INVESTIGATING, RESOLVED, REJECTED
  resolution     String?  // REFUND, COMPENSATION, WARNING, ACCOUNT_SUSPENSION
  resolutionNotes String?
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("disputes")
}

model InsurancePolicy {
  id             String   @id @default(uuid())
  packageId      String   @unique
  package        Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  plan           String   // BASIC, PREMIUM, ENTERPRISE
  premiumPaid    Float
  coverageAmount Float
  status         String   @default("ACTIVE") // ACTIVE, CLAIMED, EXPIRED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  claims         InsuranceClaim[]
  @@map("insurance_policies")
}

model InsuranceClaim {
  id             String   @id @default(uuid())
  policyId       String
  policy         InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  claimantId     String
  claimant       User     @relation("UserClaims", fields: [claimantId], references: [id], onDelete: Cascade)
  amountClaimed  Float
  description    String
  evidenceUrls   String   @default("[]") // JSON array of urls
  status         String   @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED
  settlementAmount Float?
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("insurance_claims")
}
