# Database Configuration
DB_USER=crowdcarry
DB_PASSWORD=your_secure_db_password_here
DB_NAME=crowdcarry

# App Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.vercel.app

# JWT Settings (Generate cryptographically secure keys)
JWT_SECRET=generate_a_secure_random_string_of_at_least_32_characters
JWT_REFRESH_SECRET=generate_another_different_secure_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# Stripe Payments Configuration (Optional in dev, required in production)
STRIPE_PUBLISHABLE_KEY=pk_prod_...
STRIPE_SECRET_KEY=sk_prod_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP Configuration (For real emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="Crowd Carry <noreply@crowdcarry.com>"
